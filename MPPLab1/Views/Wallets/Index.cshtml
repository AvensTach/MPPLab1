@model IEnumerable<MPPLab1.Models.Wallet>
<h2>Wallets</h2>

<form asp-action="Create" method="post" class="mb-4 d-flex gap-2">
    <input type="text" name="Name" class="form-control" placeholder="Wallet Name" required />
    <button type="submit" class="btn btn-primary">Add</button>
</form>

<table class="table">
    <thead>
        <tr>
            <th>ID</th>
            <th>Name</th>
            <th>Balance</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Id</td>
                <td>
                    <form asp-action="Edit" method="post" class="d-flex gap-2">
                        <input type="hidden" name="id" value="@item.Id" />
                        <input type="text" name="name" value="@item.Name" class="form-control form-control-sm" />
                        <button type="submit" class="btn btn-sm btn-success">Save</button>
                    </form>
                </td>
                <td>@item.Balance</td>
                <td>
                    <form asp-action="Delete" method="post">
                        <input type="hidden" name="id" value="@item.Id" />
                        <button type="submit" class="btn btn-sm btn-danger">Delete</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>